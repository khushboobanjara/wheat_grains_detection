# Copy this file to ".env" (same folder as app.py) and fill in your key.
# Get a free key at https://console.groq.com/keys
# NEVER commit your real .env file or share it.

GROQ_API_KEY=your_groq_api_key_here

# Optional: any Groq vision-capable model ID (see https://console.groq.com/docs/vision)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: seconds to wait for Groq before giving up
GROQ_TIMEOUT=90
